<Window x:Class="Kuroko.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" SizeToContent="Height" Width="320"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel Margin="18">
            <TextBlock x:Name="PromptText" Text="名前" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,10"/>
            <TextBox x:Name="Input" Height="32" Padding="8,0" VerticalContentAlignment="Center"
                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CaretBrush="{StaticResource TextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{DynamicResource S_cancel}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="{DynamicResource S_save}" Style="{StaticResource CtaButton}" Width="80" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
