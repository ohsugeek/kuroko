<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイ常駐(System.Windows.Forms.NotifyIcon)に使用 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Velopack対応のため Main を Program.cs に一本化する -->
    <StartupObject>Kuroko.Program</StartupObject>
    <ApplicationIcon>..\..\assets\kuroko.ico</ApplicationIcon>
    <AssemblyName>Kuroko</AssemblyName>
    <Product>Kuroko</Product>
    <Company>Kuroko</Company>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- ウィンドウ/タスクバーのアイコンとして参照するため、icoをリソースとして埋め込む -->
    <Resource Include="..\..\assets\kuroko.ico" Link="kuroko.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms は WinForms= エイリアスで使うため、暗黙usingを外して WPF の型(Application/MessageBox等)と曖昧化させない -->
    <Using Remove="System.Windows.Forms" />
    <!-- System.Drawing も WPF の Media(Brushes/Color/ColorConverter)と衝突するため外す(必要箇所は完全修飾) -->
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml を ApplicationDefinition から Page に変え、自動生成Mainを止めて Program.Main に一本化する -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- プレビューはエンジンからの共有メモリ直送に変更したためOpenCvSharpは不要 -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同梱する UnityCapture 仮想カメラフィルタ(MIT)。出力の vcam-src/ に置き、初回セットアップで登録する -->
    <None Include="..\..\third_party\UnityCapture\UnityCaptureFilter64.dll" Link="vcam-src\UnityCaptureFilter64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\UnityCapture\UnityCaptureFilter32.dll" Link="vcam-src\UnityCaptureFilter32.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
