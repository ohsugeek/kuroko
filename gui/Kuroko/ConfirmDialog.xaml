<Window x:Class="Kuroko.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" SizeToContent="Height" Width="330"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel Margin="18">
            <TextBlock x:Name="MessageText" Text="" Foreground="{StaticResource TextBrush}" FontSize="14"
                       TextWrapping="Wrap" LineHeight="22"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="キャンセル" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource CtaButton}" Width="88" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
