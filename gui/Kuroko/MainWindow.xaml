<Window x:Class="Kuroko.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kuroko"
        mc:Ignorable="d"
        Title="Kuroko" Height="600" Width="784"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="kuroko.ico"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" BorderBrush="#2A251F" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="100" Height="100">
                            <Border Canvas.Left="2" Canvas.Top="2" Width="96" Height="96" CornerRadius="22" Background="#F4F0E9"/>
                            <Path Data="M22 86 L22 48 C22 27 34 14 50 14 C66 14 78 27 78 48 L78 86 Z" Fill="#1A1512"/>
                            <Rectangle Canvas.Left="34" Canvas.Top="47" Width="32" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#D65A2E"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Kuroko" FontSize="15" FontWeight="Medium" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="停止中" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,10,0" VerticalAlignment="Center"/>
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Content="&#x2013;" Click="MinimizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="&#x2715;" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- コンテンツ: 2列 -->
        <Grid Grid.Row="1" Margin="14,12,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="352"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左列: プレビュー / カメラ / 開始停止 / フルプリセット ===== -->
            <StackPanel Grid.Column="0">
                <!-- プレビュー -->
                <Border Height="198" CornerRadius="8" Background="#0E0C09" BorderBrush="#2A251F" BorderThickness="1" Margin="0,0,0,12">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        <TextBlock x:Name="PreviewPlaceholder" Text="「開始」でプレビュー表示" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="ExpandButton" Content="&#x2922; 拡大" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Click="ExpandButton_Click"/>
                    </Grid>
                </Border>

                <!-- カメラ選択 -->
                <Grid Margin="0,0,0,10">
                    <Border x:Name="CameraSelector" Padding="12,9" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="CameraSelector_Click">
                        <Grid>
                            <TextBlock x:Name="CameraNameText" Text="カメラを選択" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="&#x2304;" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Popup x:Name="CameraPopup" PlacementTarget="{Binding ElementName=CameraSelector}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                            <StackPanel x:Name="CameraList" MinWidth="328"/>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 開始/停止 -->
                <Button x:Name="StartStopButton" Style="{StaticResource CtaButton}" Content="開始" Margin="0,0,0,18" Click="StartStopButton_Click"/>

                <!-- フルプリセット -->
                <TextBlock Text="フルプリセット（全設定）" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                <WrapPanel x:Name="FullPresetChips"/>
            </StackPanel>

            <!-- ===== 右列: 基本設定 / 詳細設定 ===== -->
            <StackPanel Grid.Column="2">
                <!-- 基本設定 -->
                <TextBlock Text="基本設定" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                <!-- 髪色 -->
                <StackPanel Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="髪色" Foreground="{StaticResource TextSecondaryBrush}" Width="88" VerticalAlignment="Center"/>
                        <Border x:Name="CurrentSwatch" Width="24" Height="24" CornerRadius="6" Background="#1A1512" BorderBrush="#4A443C" BorderThickness="1"/>
                        <TextBlock x:Name="CurrentHexText" Text="#1A1512" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel x:Name="ColorChips"/>
                </StackPanel>

                <!-- 彩度 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="彩度" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SatSlider" Minimum="-100" Maximum="100" Value="0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="SatValue" Text="0" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 発色（0=元の明暗を保った自然な仕上がり / 100=金髪・銀髪もはっきり出る） -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="発色" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               ToolTip="小さいほど髪本来の陰影を残して自然に、大きいほど金髪・銀髪など明るい色がはっきり出ます"/>
                    <Slider Grid.Column="1" x:Name="LiftSlider" Minimum="0" Maximum="100" Value="45" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="LiftValue" Text="0.45" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 明度 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="明度" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="BriSlider" Minimum="-100" Maximum="100" Value="0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="BriValue" Text="0" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 詳細設定 -->
                <TextBlock Text="詳細設定" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                <!-- 色相シフト -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="色相シフト" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="HueSlider" Minimum="0" Maximum="360" Value="0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="HueValue" Text="0" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 検出しきい値 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="検出しきい値" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="ThresholdSlider" Minimum="0" Maximum="100" Value="26" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="ThresholdValue" Text="0.26" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 色ガイド強度 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="色ガイド強度" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="GuideSlider" Minimum="0" Maximum="100" Value="70" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="GuideValue" Text="0.70" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 色許容度 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="色許容度" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="TolSlider" Minimum="0" Maximum="100" Value="50" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="TolValue" Text="0.50" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- エッジのぼかし -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="エッジのぼかし" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SoftSlider" Minimum="0" Maximum="40" Value="15" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="SoftValue" Text="1.5" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 既定に戻す -->
                <Button x:Name="ResetButton" Style="{StaticResource GhostButton}" Content="既定に戻す" HorizontalAlignment="Right" Click="ResetButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
