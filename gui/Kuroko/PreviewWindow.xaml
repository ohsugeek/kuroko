<Window x:Class="Kuroko.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kuroko プレビュー" Width="864" Height="534" MinWidth="360" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Icon="kuroko.ico" FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#2A251F" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="100" Height="100">
                            <Border Canvas.Left="2" Canvas.Top="2" Width="96" Height="96" CornerRadius="22" Background="#F4F0E9"/>
                            <Path Data="M22 86 L22 48 C22 27 34 14 50 14 C66 14 78 27 78 48 L78 86 Z" Fill="#1A1512"/>
                            <Rectangle Canvas.Left="34" Canvas.Top="47" Width="32" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#D65A2E"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="プレビュー" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="&#x2715;"
                        HorizontalAlignment="Right" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <Image Grid.Row="1" x:Name="BigImage" Stretch="Uniform" Margin="8"/>
    </Grid>
</Window>
